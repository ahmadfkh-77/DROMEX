rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedOwner(ownerId) {
      return request.auth != null
        && request.auth.uid == ownerId
        && request.auth.token.email_verified == true;
    }

    match /owners/{ownerId} {
      allow read, write: if isVerifiedOwner(ownerId);

      match /records/{recordId} {
        allow read, write: if isVerifiedOwner(ownerId);
      }

      match /devices/{deviceId} {
        allow read: if isVerifiedOwner(ownerId);
        allow create: if isVerifiedOwner(ownerId)
          && request.resource.data.deviceId == deviceId
          && request.resource.data.ownerEmail == request.auth.token.email;
        allow update, delete: if false;
      }
    }

    // Written only by the Admin SDK in the new-device notification function.
    match /mail/{messageId} {
      allow read, write: if false;
    }
  }
}
