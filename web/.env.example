# DROMEX web workspace: local development template.
#
# Copy this file to web/.env and fill in LOCAL DEVELOPMENT values only.
# web/.env is git-ignored and must never be committed.
# Never place production credentials, tokens, or keys in this file or in .env.
#
# Production secrets are supplied on the server through Docker secrets or an
# equivalent approved mechanism. See docs/web/docker-vps-strategy.md.

# Local development PostgreSQL (Docker Compose service "postgres").
POSTGRES_DB=dromex_dev
POSTGRES_USER=dromex_dev
POSTGRES_PASSWORD=replace-with-a-local-only-development-password

# API listen configuration inside the container.
API_HOST=0.0.0.0
API_PORT=3000

# HOST-SIDE connection string, used by `npm run dev --workspace apps/api`
# running directly on your machine. It reaches the database through the
# published loopback port 5433.
#
# Docker Compose does NOT read this value. The compose file builds its own
# container-side URL from the POSTGRES_* values above, reaching the database
# at postgres:5432 on the private Docker network. The two are deliberately
# different: "postgres" is a hostname that only resolves inside that network.
DATABASE_URL=postgresql://dromex_dev:replace-with-a-local-only-development-password@127.0.0.1:5433/dromex_dev

# Authentication. The API refuses to start until every value below is valid.
# DROMEX_ENVIRONMENT is one of: development, test, production.
DROMEX_ENVIRONMENT=development

# Versioned authentication secrets. Deliberately empty, so the API refuses to
# start until real ones are set.
#
# Format: comma-separated <version>:<secret> entries, for example
#   DROMEX_AUTH_SECRETS=2:<current secret>,1:<previous secret>
# The highest version is current: it signs cookies and encrypts new TOTP and
# recovery-code data. Keep every older version that ever encrypted data, or
# that data can no longer be decrypted. Versions are positive whole numbers;
# secrets are at least 32 characters with no whitespace or commas.
#
# Generate each secret locally, for example with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never commit a value, and never reuse a development secret in production.
#
# The former single DROMEX_AUTH_SECRET is no longer accepted, and the API also
# refuses to start if BETTER_AUTH_SECRETS, BETTER_AUTH_SECRET, or AUTH_SECRET
# is set, because Better Auth could otherwise read them on its own.
DROMEX_AUTH_SECRETS=

# The API's own origin, and the browser origins allowed to call it.
# Comma-separated, explicit origins only; wildcards are refused.
DROMEX_AUTH_BASE_URL=http://127.0.0.1:3000
DROMEX_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173

# Development only, and refused in any other environment. Leave false unless
# Secure cookies have been shown not to work over loopback.
DROMEX_AUTH_ALLOW_INSECURE_COOKIES=false
