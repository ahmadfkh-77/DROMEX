# DROMEX web workspace: local development template.
#
# Copy this file to web/.env and fill in LOCAL DEVELOPMENT values only.
# web/.env is git-ignored and must never be committed.
# Never place production credentials, tokens, or keys in this file or in .env.
#
# Production secrets are supplied on the server through Docker secrets or an
# equivalent approved mechanism. See docs/web/docker-vps-strategy.md.

# Local development PostgreSQL (Docker Compose service "postgres").
POSTGRES_DB=dromex_dev
POSTGRES_USER=dromex_dev
POSTGRES_PASSWORD=replace-with-a-local-only-development-password

# API listen configuration inside the container.
API_HOST=0.0.0.0
API_PORT=3000

# HOST-SIDE connection string, used by `npm run dev --workspace apps/api`
# running directly on your machine. It reaches the database through the
# published loopback port 5433.
#
# Docker Compose does NOT read this value. The compose file builds its own
# container-side URL from the POSTGRES_* values above, reaching the database
# at postgres:5432 on the private Docker network. The two are deliberately
# different: "postgres" is a hostname that only resolves inside that network.
DATABASE_URL=postgresql://dromex_dev:replace-with-a-local-only-development-password@127.0.0.1:5433/dromex_dev
