    "better-auth": "1.7.4",
    "fastify": "5.12.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "auth": "1.7.4",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
